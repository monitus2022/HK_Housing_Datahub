# Local data processing, imports, and tests do not require any values in this
# file. Credentials are validated only when a cloud upload is attempted.

# ---------------------------------------------------------------------------
# Cloud storage credentials (required only for upload)
# ---------------------------------------------------------------------------
cloud_storage_access_key_id=
cloud_storage_secret_access_key=

# Cloudflare R2 only. Required when src/config/config.yml sets
# cloud_storage.service_type to "cloudflare". Leave empty for AWS S3.
cloudflare_account_id=

# ---------------------------------------------------------------------------
# Optional agency API token (currently unused)
# ---------------------------------------------------------------------------
# The crawler obtains fresh cookies from the HKP homepage and does not read
# this key today. It is kept as a placeholder for a future authenticated mode.
AGENCY_API_COOKIES_TOKEN=
