// ER diagram for HK_Housing_Datahub.
// Source of truth: src/models/agency/sql_db.py and src/models/rvd/sql_db.py.
// Baseline snapshot: docs/baseline-stats.md (2026-11-09).

TableGroup location_hierarchy {
  regions
  subregions
  districts
}

TableGroup estate_info {
  estates
  estate_school_nets
  estate_facilities
  estate_mtr_lines
  estate_monthly_market_info
}

TableGroup buildings {
  phases
  buildings
}

TableGroup property_units {
  units
  unit_features
  transactions
}

TableGroup lookup {
  facilities
}

TableGroup run_metadata {
  pipeline_runs
}

TableGroup rvd_benchmarks {
  rvd_rents
  rvd_prices
  rvd_indices
  rvd_yields
}

Table regions {
  region_id text [pk]
  region_name_zh text [not null]
  region_name_en text [not null]
}

Table subregions {
  subregion_id text [pk]
  subregion_name_zh text [not null]
  subregion_name_en text [not null]
  region_id text [not null]
}

Table districts {
  district_id text [pk]
  district_name_zh text [not null]
  district_name_en text [not null]
  subregion_id text [not null]
}

Table estates {
  estate_id text [pk]
  estate_name_zh text [not null]
  estate_name_en text [not null]
  region_id text [not null]
  subregion_id text [not null]
  district_id text [not null]
  address_zh text
  address_en text [not null]
  first_op_date datetime
  last_op_date datetime
  latitude real
  longitude real
}

Table estate_school_nets {
  estate_id text [not null]
  school_net_id text [not null]
  school_net_name_zh text [not null]
  school_net_name_en text [not null]

  indexes {
    (estate_id, school_net_id) [pk]
  }
  Note: 'Primary key is (estate_id, school_net_id). The ID is the primary-school net; the name comes from the secondary-school net.'
}

Table estate_facilities {
  estate_id text [not null]
  facility_id text [not null]

  indexes {
    (estate_id, facility_id) [pk]
  }
}

Table facilities {
  facility_id text [pk]
  facility_name_zh text
  facility_name_en text [not null]
}

Table estate_mtr_lines {
  estate_id text [not null]
  mtr_line_name_zh text
  mtr_line_name_en text [not null]

  indexes {
    (estate_id, mtr_line_name_en) [pk]
  }
  Note: 'Only the first MTR line per estate is captured by the current mapper.'
}

Table estate_monthly_market_info {
  estate_id text [not null]
  record_date datetime [not null]
  avg_ft_price real
  avg_net_ft_price real
  max_ft_price real
  min_ft_price real
  max_net_ft_price real
  min_net_ft_price real
  avg_ft_rent real
  avg_net_ft_rent real
  max_ft_rent real
  min_ft_rent real
  max_net_ft_rent real
  min_net_ft_rent real
  total_tx_count integer
  total_rent_tx_count integer
  total_tx_amount real
  total_rent_tx_amount real

  indexes {
    (estate_id, record_date) [pk]
  }
  Note: 'Grain: estate x month. Contains both sale and rent aggregates. Date range 1996-12 to 2025-08 in the baseline.'
}

Table phases {
  phase_id text [pk]
  phase_name_zh text [not null]
  phase_name_en text [not null]
  estate_id text [not null]
}

Table buildings {
  building_id text [pk]
  building_name_zh text [not null]
  building_name_en text [not null]
  estate_id text [not null]
  phase_id text
  Note: 'phase_id is nullable because small estates may have no phase.'
}

Table units {
  unit_id text [pk]
  floor text
  flat text [not null]
  area real
  net_area real
  bedroom integer
  sitting_room integer
  building_id text [not null]
  Note: 'floor is raw text and may contain G, UG, LG, PH, -, or an empty value.'
}

Table unit_features {
  unit_id text [not null]
  feature_id text [not null]
  feature_name_zh text
  feature_name_en text [not null]

  indexes {
    (unit_id, feature_id) [pk]
  }
  Note: 'Replaces the stale unit_facilities name. The source uses the English feature name as the ID.'
}

Table transactions {
  tx_id text [pk]
  tx_date datetime [not null]
  price real [not null]
  last_tx_date datetime
  gain real
  net_ft_price real
  unit_id text [not null]
  Note: 'No transaction-type column exists; treat rows as sale transactions. The current database has only primary-key autoindexes; Phase 5 adds dashboard indexes.'
}

Table rental_transactions {
  rental_id text [pk]
  tx_date datetime [not null]
  price real [not null]
  net_area real
  area real
  net_ft_price real
  bedroom integer
  estate_id text [not null]
  estate_name_en text
  district_id text [not null]
  district_name_en text
  phase_id text
  phase_name_en text
  building_id text
  building_name_en text
  source text
  Note: 'Lease/rental transactions from HKP tx_type=L. HKP supports only 1-year or 3-year lookbacks.'
}

Table rvd_rents {
  region_code text [not null]
  property_class text [not null]
  month text [not null]
  value_hkd_m2 real
  is_provisional integer [not null]
  indexes {
    (region_code, property_class, month) [pk]
  }
  Note: 'Official RVD private domestic average rent, HKD/m2/month. NULL means suppressed.'
}

Table rvd_prices {
  region_code text [not null]
  property_class text [not null]
  month text [not null]
  value_hkd_m2 real
  is_provisional integer [not null]
  indexes {
    (region_code, property_class, month) [pk]
  }
  Note: 'Official RVD private domestic average price, HKD/m2. NULL means suppressed.'
}

Table rvd_indices {
  index_type text [not null]
  property_class text [not null]
  month text [not null]
  value real
  is_provisional integer [not null]
  indexes {
    (index_type, property_class, month) [pk]
  }
  Note: 'Territory-wide RVD rental/price indices, 1999 = 100.'
}

Table rvd_yields {
  property_class text [not null]
  month text [not null]
  yield_pct real
  is_provisional integer [not null]
  indexes {
    (property_class, month) [pk]
  }
  Note: 'Official RVD private domestic market yield, percent.'
}

Table pipeline_runs {
  run_id text [pk]
  started_at datetime [not null]
  finished_at datetime
  mode text [not null]
  status text [not null]
  record_counts_json text
  error_message text
  Note: 'One row per agency pipeline run; status is running, success, or failed.'
}

Ref: subregions.region_id > regions.region_id
Ref: districts.subregion_id > subregions.subregion_id
Ref: estates.region_id > regions.region_id
Ref: estates.subregion_id > subregions.subregion_id
Ref: estates.district_id > districts.district_id
Ref: estate_school_nets.estate_id > estates.estate_id
Ref: estate_facilities.estate_id > estates.estate_id
Ref: estate_facilities.facility_id > facilities.facility_id
Ref: estate_mtr_lines.estate_id > estates.estate_id
Ref: estate_monthly_market_info.estate_id > estates.estate_id
Ref: phases.estate_id > estates.estate_id
Ref: buildings.estate_id > estates.estate_id
Ref: buildings.phase_id > phases.phase_id
Ref: units.building_id > buildings.building_id
Ref: unit_features.unit_id > units.unit_id
Ref: transactions.unit_id > units.unit_id
