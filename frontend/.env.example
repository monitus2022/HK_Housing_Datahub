# Public base URL for the serving snapshot, without a trailing slash.
# The live production fallback is in .env.production; a Pages env var overrides it.
# Leave empty when the frontend and /dashboard are served from the same origin.
VITE_DASHBOARD_BASE_URL=https://hk-housing-datahub.monitus.org

# Natural-language search box. Off by default: the live site is untouched until
# the separate NL deployment sets this variable to true.
VITE_FEATURE_NL_SEARCH=false
